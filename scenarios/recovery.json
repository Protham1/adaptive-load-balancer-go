{
 "name": "recovery",
 "description": "Backend-2 is down from t=10s to t=30s, then restored; expect traffic to return after health checks pass.",
 "seed": 42,
 "request_path": "/work",
 "arrivals": "poisson",
 "phases": [
  {
   "type": "fixed",
   "duration_s": 70,
   "rps": 300
  }
 ],
 "mix": {
  "long_fraction": 0.0,
  "long_delay_ms": 0,
  "short_delay_ms": 0
 },
 "faults": [
  {
   "at_s": 10,
   "backend": "Backend-2",
   "set": {
    "down": true
   }
  },
  {
   "at_s": 30,
   "backend": "Backend-2",
   "set": {
    "down": false
   }
  }
 ],
 "timeout_ms": 5000,
 "max_in_flight": 5000
}
